        {
          "key": "caption",
          "type": "html",
          "label": "Caption (optional)",
          "default": ""
        },
        {
          "key": "doc_label",
          "type": "text",
          "label": "Excerpt: product and page",
          "default": ""
        },
        {
          "key": "doc_heading",
          "type": "text",
          "label": "Excerpt: the page's own heading",
