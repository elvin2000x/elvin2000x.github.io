    "landing"
  ],
  "fields": [
    {
      "key": "bg",
      "type": "choice",
      "label": "Background",
      "options": [
        {
          "value": "",
          "label": "Plain"
        },
        {
          "value": "tint",
          "label": "Tint"
        }
      ]
    },
    {
      "key": "anchor",
      "type": "text",
